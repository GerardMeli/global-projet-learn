# =============================================================================
# .env.example — VoteSaaS Platform
# =============================================================================
# Copiez ce fichier en .env et remplissez les valeurs.
# IMPORTANT : Ne jamais committer le fichier .env dans git !
# Ajoutez ".env" dans votre .gitignore.
#
# Commande : cp .env.example .env
# =============================================================================

# =============================================================================
# BASE DE DONNÉES — PostgreSQL
# =============================================================================

# Hôte PostgreSQL (nom du service Docker dans docker-compose)
POSTGRES_HOST=postgres

# Port PostgreSQL (défaut : 5432)
POSTGRES_PORT=5432

# Nom de l'utilisateur PostgreSQL principal
POSTGRES_USER=votesaas

# Mot de passe de l'utilisateur PostgreSQL (changer en production !)
POSTGRES_PASSWORD=votesaas_secret_2024

# =============================================================================
# CACHE — Redis
# =============================================================================

# Hôte Redis (nom du service Docker dans docker-compose)
REDIS_HOST=redis

# Port Redis (défaut : 6379)
REDIS_PORT=6379

# Mot de passe Redis (changer en production !)
REDIS_PASSWORD=redis_secret_2024

# =============================================================================
# MESSAGE BROKER — RabbitMQ
# =============================================================================

# Hôte RabbitMQ (nom du service Docker)
RABBITMQ_HOST=rabbitmq

# Port AMQP de RabbitMQ (défaut : 5672)
RABBITMQ_PORT=5672

# Nom d'utilisateur administrateur RabbitMQ
RABBITMQ_USER=votesaas

# Mot de passe administrateur RabbitMQ (changer en production !)
RABBITMQ_PASSWORD=votesaas_rabbit_2024

# =============================================================================
# SÉCURITÉ — JWT (JSON Web Tokens)
# =============================================================================

# Clé secrète pour signer les JWT.
# IMPORTANT : Doit faire au minimum 256 bits (32 caractères).
# Générer avec : openssl rand -base64 64
JWT_SECRET=your_very_long_jwt_secret_key_minimum_256_bits_please_change_this_in_production

# Durée de validité du token d'accès en millisecondes
# 900000 = 15 minutes
JWT_ACCESS_EXPIRATION_MS=900000

# Durée de validité du token de rafraîchissement en millisecondes
# 604800000 = 7 jours
JWT_REFRESH_EXPIRATION_MS=604800000

# =============================================================================
# SÉCURITÉ — OTP (One-Time Password)
# =============================================================================

# Durée de validité d'un code OTP en minutes (défaut : 10 minutes)
OTP_EXPIRATION_MINUTES=10

# Nombre maximum de tentatives de saisie d'un OTP avant blocage
OTP_MAX_ATTEMPTS=3

# =============================================================================
# EMAIL — SMTP Gmail
# =============================================================================
# Pour utiliser Gmail :
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Allez dans : Compte Google > Sécurité > Mots de passe des applications
# 3. Créez un mot de passe pour "Mail" > copiez le mot de passe généré
# 4. Utilisez ce mot de passe dans MAIL_PASSWORD (pas votre mot de passe Gmail)
# =============================================================================

# Serveur SMTP Gmail
MAIL_HOST=smtp.gmail.com

# Port SMTP avec STARTTLS
MAIL_PORT=587

# Votre adresse Gmail
MAIL_USERNAME=your_gmail@gmail.com

# Mot de passe d'application Gmail (généré dans les paramètres de sécurité Google)
# Format : xxxx xxxx xxxx xxxx (16 caractères avec espaces)
MAIL_PASSWORD=your_gmail_app_password_here

# Nom affiché comme expéditeur dans les emails
MAIL_FROM_NAME=VoteSaaS

# Adresse email de l'expéditeur (peut être différente de MAIL_USERNAME)
MAIL_FROM_ADDRESS=noreply@votesaas.cm

# =============================================================================
# APPLICATION
# =============================================================================

# URL publique du frontend Angular (sans slash final)
APP_FRONTEND_URL=http://localhost:4200

# URL publique de l'API Gateway (sans slash final)
APP_API_URL=http://localhost:8080

# Nom de l'application (utilisé dans les emails et l'interface)
APP_NAME=VoteSaaS

# =============================================================================
# SUPER ADMIN — Créé automatiquement au premier démarrage
# =============================================================================

# Email du super administrateur système
SUPER_ADMIN_EMAIL=admin@votesaas.cm

# Mot de passe du super administrateur
# Règles : 8+ caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial
SUPER_ADMIN_PASSWORD=Admin@2024!

# Prénom du super administrateur
SUPER_ADMIN_FIRST_NAME=System

# Nom du super administrateur
SUPER_ADMIN_LAST_NAME=Admin
