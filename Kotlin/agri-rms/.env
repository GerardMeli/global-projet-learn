# ============================================================
#  manage-users — variables d'environnement
#  Copier ce fichier en .env et adapter les valeurs
# ============================================================

# --- Application ---
APP_NAME=manage-users
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_db
DB_USERNAME=postgres
DB_PASSWORD=root

# --- JPA / Hibernate ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# --- Thymeleaf ---
THYMELEAF_CACHE=false

# --- Session ---
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false   # true en production (HTTPS)

# --- Logging ---
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_MAIL=DEBUG

# --- Mail SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=reli237rou@gmail.com
MAIL_PASSWORD=vomnetvaulnliyks
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true

# --- Email applicatif ---
EMAIL_FROM=ngandjougerard@gmail.com
EMAIL_ENABLED=false

# --- URLs ---
#FRONTEND_URL=http://localhost:4200
#BASE_URL=http://localhost:8083

# --- JWT ---
# Générer un secret fort en prod : openssl rand -base64 64
JWT_SECRET=TGHJVxyGBVg9oBpHJED2bECDujeT+gd3Hm1Uy2TE3N0Rv+m+mFE2oE/ucN692Wp6pwqKc9eVEk6SbHwHVwcykQ==
JWT_ACCESS_EXPIRATION=3600000         # 1 heure (ms)
JWT_REFRESH_EXPIRATION=2592000000     # 30 jours (ms)
JWT_EMAIL_VERIFICATION_EXPIRATION=86400000   # 24 heures (ms)
JWT_PASSWORD_RESET_EXPIRATION=1800000        # 30 minutes (ms)
JWT_EMAIL_CHANGE_EXPIRATION=3600000          # 1 heure (ms)
JWT_ACCOUNT_SETUP_EXPIRATION=86400000        # 24 heures (ms)